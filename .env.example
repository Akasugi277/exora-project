# Global
PROJECT_NAME=exora-project

# PostgreSQL (Galileo)
POSTGRES_DB=galileo
POSTGRES_USER=galileo_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# For local dev (outside Docker): use localhost
# For Docker Compose: overridden automatically to use service name 'postgres'
DATABASE_URL=postgresql://galileo_user:change_me@localhost:5432/galileo

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Discord bot tokens
DISCORD_TOKEN_JUPITER=replace_me
DISCORD_TOKEN_SATURN=replace_me
DISCORD_TOKEN_URANUS=replace_me
DISCORD_TOKEN_NEPTUNE=replace_me

# Discord OAuth2 (for dashboard login — use the "Exora-Project" application)
# Client ID and Secret are found in Developer Portal > OAuth2
DISCORD_CLIENT_ID=replace_me
DISCORD_CLIENT_SECRET=replace_me
# Redirect URI must be registered in Developer Portal > OAuth2 > Redirects
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Session signing secret — use a random 32+ character string
SESSION_SECRET=replace_me_with_random_32_char_string

# App ports (local dev)
JUPITER_PORT=7001
SATURN_PORT=7002
URANUS_PORT=7003
NEPTUNE_PORT=7004
DASHBOARD_PORT=3000
